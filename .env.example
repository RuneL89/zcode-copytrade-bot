# =============================================================================
# ZCode Bot — example environment. Copy to .env and fill in values LOCALLY.
# Never paste secrets into chat, commits, or the ZCode MCP process.
# Only placeholders appear in this file.
# =============================================================================

# --- Mode ---------------------------------------------------------------------
# demo | paper | live   (paper is the default and the only safe default)
MODE=paper

# Required only when MODE=live. Must match the exact confirmation string
# documented in docs/RUNBOOK.md (readiness -> arming live).
# LIVE_TRADING_ACK=I UNDERSTAND LIVE MODE SIGNS AND SUBMITS REAL SOLANA TRANSACTIONS

# --- Server -------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# 32+ random chars. Generates sessions/CSRF tokens. Generated locally.
SESSION_SECRET=replace-with-32-plus-random-characters
# Directory for SQLite DB, wallet, snapshots, inbox (default ./data)
DATA_DIR=./data

# --- Dashboard user -----------------------------------------------------------
# The first-run setup wizard creates the user in the app; no password goes here.
# Optional: username for the seeded initial user (setup still requires the
# one-time token printed on the server console).
# SETUP_USERNAME=admin

# --- Solana providers (keys entered locally by the user, never in chat) -------
# Helius API key from https://dashboard.helius.dev  (paper/live monitoring)
HELIUS_API_KEY=
# Helius webhook auth secret (optional webhook adapter; polling is the baseline)
HELIUS_WEBHOOK_SECRET=
# Polling interval for leader activity, milliseconds
LEADER_POLL_INTERVAL_MS=8000
# Free public Solana JSON-RPC used by the candidate activity refresh (research
# phase) so those bursts never spend Helius credits. Empty = fall back to
# Helius for the refresh too. The trading monitor never uses this endpoint.
PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Jupiter ------------------------------------------------------------------
# Free rate-limited tier: https://lite-api.jup.ag  (default, no key)
# Production:  https://api.jup.ag with an x-api-key from developers.jup.ag portal
JUPITER_BASE_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# --- Copy strategy ------------------------------------------------------------
COPY_SCALE=0.25
MIN_PER_BUY_USD=10
MAX_PER_BUY_USD=250
MAX_POSITION_USD=250
MAX_TOTAL_EXPOSURE_USD=1000
MAX_TRADES_PER_DAY=40
MAX_DAILY_REALIZED_LOSS_USD=100

# --- Risk limits --------------------------------------------------------------
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=300
MAX_COPY_EVENT_AGE_SECONDS=90
LEADERBOARD_MAX_AGE_SECONDS=86400
PRICE_MAX_AGE_SECONDS=45

# --- ZCode research -----------------------------------------------------------
RECOMMENDATION_TTL_MS=10800000
FIRED_TRADER_COOLDOWN_MS=86400000
# zcode_shortlist (default, fail-closed) | deterministic_fallback (opt-in)
CANDIDATE_REPLACEMENT_MODE=zcode_shortlist

# --- Loss streak / firing -----------------------------------------------------
# fully_closed_position (default) | every_partial_close
LOSS_STREAK_UNIT=fully_closed_position
# close_all_before_switch (default) | keep_positions
FIRE_POSITION_POLICY=close_all_before_switch

# --- Optional notifications ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- FOMO web discovery (optional; automatic leaderboard refresh) --------------
# Set the leaderboard URL to enable the read-only browser adapter. The browser
# window is visible and you log in once yourself; the session is saved locally.
# FOMO_BROWSER_CHANNEL=chrome   (use real Chrome; avoids Google blocking OAuth)
# FOMO_LEADERBOARD_URL=https://fomo.family/leaderboard
# FOMO_ROBOTS_URL=
# Selector for the Solana address text on trader profile pages (setup inspects it)
# FOMO_PROFILE_ADDRESS_SELECTOR=
# Leaderboard refresh interval (default 6h)
# FOMO_WEB_POLL_MS=21600000

# --- ZCode MCP server allowlist (apps/zcode-mcp only) --------------------------
# These are the ONLY variables passed to the MCP process. Never copy .env there.
ZCODE_MCP_SNAPSHOT_DIR=./data/research/snapshot
ZCODE_MCP_INBOX_DIR=./data/research/inbox

# --- Automatic trader rotation (flat-only) -------------------------------------
# Paper/demo rotate whenever a fresh recommendation asks for it. Live mode is
# opt-in: an armed live session only rotates when this is true.
# ROTATE_ON_REFRESH=true
