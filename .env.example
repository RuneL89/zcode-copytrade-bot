# =============================================================================
# ZCode Bot — example environment. Copy to .env and fill in values LOCALLY.
# Never paste secrets into chat, commits, or the ZCode MCP process.
# Only placeholders appear in this file.
# =============================================================================

# --- Mode ---------------------------------------------------------------------
# demo | paper | live   (paper is the default and the only safe default)
MODE=paper

# Required only when MODE=live. Must match the exact confirmation string
# documented in docs/RUNBOOK.md (readiness -> arming live).
# LIVE_TRADING_ACK=I UNDERSTAND LIVE MODE SIGNS AND SUBMITS REAL SOLANA TRANSACTIONS WITH REAL FUNDS
# Hard switch. false (default) never signs, even in MODE=live.
# true refuses to boot unless the P1 acceptance checks pass.
LIVE_TRADING=false
# Encrypted wallet (scrypt N=16384 r=8 p=1, AES-256-GCM, JSON {secretKey: base64}).
# Unset uses DATA_DIR/wallet/zcode-bot-wallet.json.
# WALLET_FILE=/var/lib/copydesk/wallet.json
# COPYDESK_WALLET_PASSPHRASE=
# PIN required before the dashboard will raise a risk limit. Empty rejects increases.
# RISK_PIN=

# --- Server -------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Production marks cookies Secure. Loopback and Tailscale (100.64.0.0/10) stay
# usable over plain HTTP without this. Set it when the browser host is neither.
# FORCE_INSECURE_COOKIE=1
# 32+ random chars. Generates sessions/CSRF tokens. Generated locally.
SESSION_SECRET=replace-with-32-plus-random-characters
# Directory for the SQLite DB and the wallet (default ./data)
DATA_DIR=./data

# --- Dashboard user -----------------------------------------------------------
# The first-run setup wizard creates the user in the app; no password goes here.
# Optional: username for the seeded initial user (setup still requires the
# one-time token printed on the server console).
# SETUP_USERNAME=admin

# --- Solana providers (keys entered locally by the user, never in chat) -------
# Helius API key from https://dashboard.helius.dev  (paper/live monitoring)
HELIUS_API_KEY=
# Project id for the Admin usage API. The worker reconciles it every 30 minutes.
# HELIUS_PROJECT_ID=
# Helius webhook auth secret (optional webhook adapter; polling is the baseline)
HELIUS_WEBHOOK_SECRET=
# Polling interval for leader activity, milliseconds
LEADER_POLL_INTERVAL_MS=8000
# Free public Solana JSON-RPC used by the candidate activity refresh (
# phase) so those bursts never spend Helius credits. Empty = fall back to
# Helius for the refresh too. The trading monitor never uses this endpoint.
PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Jupiter ------------------------------------------------------------------
# Swap API v2 on api.jup.ag. Free key from developers.jup.ag (about 1 request/second).
# Paper mode runs without a key and prices from the public price fallback.
JUPITER_BASE_URL=https://api.jup.ag
JUPITER_API_KEY=

# --- Copy strategy ------------------------------------------------------------
# Paper bankroll. 80% of this may be deployed at once ($80 on the $100 default).
EQUITY_START_USD=100
COPY_SCALE=0.25
MIN_PER_BUY_USD=2
MAX_PER_BUY_USD=10
MAX_OPEN_PER_TRADER_USD=40
MAX_DEPLOYED_PCT=80
# Roster-wide exposure cap to one mint; 0 disables it.
PER_MINT_CAP_USD=0
# There is no portfolio daily-loss or lifetime-drawdown gate (D7). The
# per-position stop/trail/time exits and the deployment cap are the safety
# model. Do not add MAX_DAILY_REALIZED_LOSS_USD: it is not read.


# --- Risk limits --------------------------------------------------------------
MAX_SLIPPAGE_BPS=300
MAX_PRICE_IMPACT_BPS=300
MAX_COPY_EVENT_AGE_SECONDS=90
LEADERBOARD_MAX_AGE_SECONDS=86400
PRICE_MAX_AGE_SECONDS=45

# --- Retired research knobs (D6) ------------------------------------------------
# RECOMMENDATION_TTL_MS, FIRED_TRADER_COOLDOWN_MS and CANDIDATE_REPLACEMENT_MODE
# belonged to the retired ordering pipeline and are ignored now: the loader only
# reads keys it knows, so entries left in an old .env do nothing.

# --- Loss streak / firing -----------------------------------------------------
# fully_closed_position (default) | every_partial_close
LOSS_STREAK_UNIT=fully_closed_position
# close_all_before_switch (default) | keep_positions
FIRE_POSITION_POLICY=close_all_before_switch

# --- Optional notifications ---------------------------------------------------
# Telegram is not part of the paper desk. Leave both empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Local agent API. Empty disables /api/agent/*. The token cannot arm or sign.
# AGENT_API_TOKEN=
# Agent fire/exit requests are refused while MODE=live unless this is true.
# AGENT_LIVE_CONTROL=false
# Outbound POST when a seat is left empty. Empty disables it.
# AGENT_WEBHOOK_URL=http://127.0.0.1:8799/seat
# auto fills a free seat from the bench. agent waits for a hire decision.
HIRE_APPROVAL=auto

# --- fomoapi.io discovery inlet (D3; the primary handle/wallet source) ---------
# Free tier only: 250,000 credits/month, 250 credits per leaderboard request,
# ~125 per alerts request. The key stays local — it is never logged, and the
# dashboard only ever shows configured / not configured.
# FOMOAPI_KEY=
# FOMOAPI_BASE_URL=https://api.fomoapi.io

# --- FOMO web capture (FALLBACK ONLY since D3; manual, never scheduled) --------
# The automatic inlet is the fomoapi leaderboard above. This browser adapter is
# the manual fallback and stays off unless you set the URL yourself. The browser
# window is visible and you log in once yourself; the session is saved locally.
# FOMO_BROWSER_CHANNEL=chrome   (use real Chrome; avoids Google blocking OAuth)
# FOMO_LEADERBOARD_URL=https://fomo.family/leaderboard
# FOMO_ROBOTS_URL=
# Selector for the Solana address text on trader profile pages (setup inspects it)
# FOMO_PROFILE_ADDRESS_SELECTOR=
# Leaderboard refresh interval (default 6h)
# FOMO_WEB_POLL_MS=21600000

# --- Retired (D6) ---------------------------------------------------------------
# The ZCode research pipeline (snapshot + restricted MCP server + pinned agent +
# ordering/rotation) is retired: admission is the deterministic discovery →
# watch list → shadow ledger → promotion path. ROTATE_ON_REFRESH and the
# ZCODE_MCP_* variables are gone with it; the tables stay as legacy data.
